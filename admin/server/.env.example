# 服务端口
PORT=3000
NODE_ENV=development

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admin_rbac

# JWT 密钥（生产环境务必替换为随机长字符串）
JWT_ACCESS_SECRET=dev_access_secret_please_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# 前端地址（CORS 白名单，多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173
